          "InBearbeitung",
          "Abholbereit"
        ],
        "type": "string"
      },
      "CreateTicketDto": {
        "required": [
          "car",
          "customerName",
          "toDos"
        ],
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "car": {
            "type": "string",
            "nullable": true
          },
          "carStatus": {
            "$ref": "#/components/schemas/CarStatusEnum"
          },
          "toDos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DbUser": {
        "required": [
          "id",
          "isAdmin",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "TicketDto": {
        "required": [
          "car",
          "customerName",
          "toDos"
        ],
        "type": "object",
        "properties": {
          "ticketnumber": {
            "type": "string",
            "nullable": true
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "car": {
            "type": "string",
            "nullable": true
          },
          "carStatus": {
            "$ref": "#/components/schemas/CarStatusEnum"
          },
          "toDos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ToDoDto": {
        "required": [
          "done",
          "task"
        ],
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "nullable": true
          },
          "done": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UserDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
